{
  "name": "kvrn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "deploy": "npx opennextjs-cloudflare build && npx opennextjs-cloudflare deploy",
    "deploy:preview": "npx opennextjs-cloudflare build && npx opennextjs-cloudflare deploy --env preview",
    "cf:build": "npx opennextjs-cloudflare build",
    "test": "jest",
    "qa:contracts": "node scripts/verify-route-contracts.mjs",
    "qa:smoke": "node scripts/smoke-test.mjs",
    "test:ci": "jest --runInBand --json --outputFile=/tmp/kvrn-jest.json",
    "qa:ai-boundaries": "node scripts/verify-ai-boundaries.mjs",
    "qa:browser": "node scripts/browser-smoke.mjs",
    "qa:change-coverage": "node scripts/verify-change-test-coverage.mjs",
    "qa:ai-readiness": "node scripts/verify-ai-os-readiness.mjs",
    "qa:ai-imports": "node scripts/verify-ai-local-imports.mjs",
    "qa:adversarial": "node scripts/verify-adversarial-continuation.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@stripe/react-stripe-js": "^2.7.1",
    "@stripe/stripe-js": "^4.1.0",
    "clsx": "^2.1.1",
    "next": "15.5.27",
    "postal-mime": "^4.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^3.3.0",
    "stripe": "^16.2.0",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.19.10",
    "@types/jest": "29.5.14",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.23",
    "jest": "29.7.0",
    "jest-util": "29.7.0",
    "pg": "^8.23.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "ts-jest": "29.4.12",
    "typescript": "^5.5.3",
    "wrangler": "4.92.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "esModuleInterop": true
          }
        }
      ]
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.next/"
    ]
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.5"
  }
}
