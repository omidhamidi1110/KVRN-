{
  "name": "kvrn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "deploy": "npx opennextjs-cloudflare build && npx opennextjs-cloudflare deploy",
    "deploy:preview": "npx opennextjs-cloudflare build && npx opennextjs-cloudflare deploy --env preview",
    "cf:build": "npx opennextjs-cloudflare build",
    "test": "jest"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@stripe/react-stripe-js": "^2.7.1",
    "@stripe/stripe-js": "^4.1.0",
    "clsx": "^2.1.1",
    "next": "15.5.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^3.3.0",
    "stripe": "^16.2.0",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.19.10",
    "@types/jest": "29.5.14",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.18",
    "jest": "29.7.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "ts-jest": "29.4.12",
    "typescript": "^5.5.3",
    "wrangler": "4.92.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "esModuleInterop": true
          }
        }
      ]
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.next/"
    ]
  }
}