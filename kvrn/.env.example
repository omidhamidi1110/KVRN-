# KVRN environment variables — never commit real values

# Neon PostgreSQL (Cloudflare secret)
DATABASE_URL=

# Stripe (Cloudflare secrets). Mode is chosen DELIBERATELY via STRIPE_MODE (a Cloudflare variable):
#   STRIPE_MODE unset or "test"  -> STRIPE_SECRET_KEY must be sk_test_...
#   STRIPE_MODE=live             -> STRIPE_SECRET_KEY must be sk_live_...
# A live key without STRIPE_MODE=live is rejected, as is a test key under STRIPE_MODE=live.
# Restricted keys (rk_...) are not supported. See STRIPE-LIVE-MODE.md.
STRIPE_SECRET_KEY=
# The signing secret of the webhook endpoint in the SAME mode as the key above.
STRIPE_WEBHOOK_SECRET=

# Cloudflare Access (Cloudflare secrets)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDIENCE=
ADMIN_EMAIL_ALLOWLIST=

# Worker ordinary variables (set in Cloudflare dashboard Variables section)
SITE_URL=
STRIPE_MODE=test
# Canonical checkout gate. Must be exactly "true" to open checkout; default CLOSED.
# Keep it unset/false until STRIPE_WEBHOOK_SECRET is verified in the target mode.
ENABLE_CHECKOUT=false
# Legacy gate, honoured only when ENABLE_CHECKOUT is NOT set, and only in test mode.
# It can never open live checkout. wrangler.toml still sets it to "false".
ENABLE_STRIPE_TEST_CHECKOUT=false

# Google Analytics 4 (see GA4-INTEGRATION.md). Both are optional; GA is simply off without them.
# Measurement ID: public, G-XXXXXXXXXX. Set it as a RUNTIME Worker variable in the Cloudflare dashboard.
# It is NOT needed at build time: no source file inlines it (NEXT_PUBLIC_* is inlined by `next build`, and
# the build may run where this variable does not exist). The browser reads it per request from
# GET /api/analytics/config, and only after effective analytics consent. GA loads only after a visitor
# accepts analytics (and no Do Not Track / Global Privacy Control).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Measurement Protocol API secret for the server-side purchase (a Cloudflare SECRET, never a plain
# variable, never NEXT_PUBLIC_). Without it no server-side purchase is sent.
GA4_MEASUREMENT_PROTOCOL_SECRET=

# Local development / integration tests only — never set in Cloudflare
# DEV_ADMIN_EMAIL=
# TEST_DATABASE_URL=
