# KVRN environment variables — never commit real values

# Neon PostgreSQL (Cloudflare secret)
DATABASE_URL=

# Stripe (Cloudflare secrets). Mode is chosen DELIBERATELY via STRIPE_MODE (a Cloudflare variable):
#   STRIPE_MODE unset or "test"  -> STRIPE_SECRET_KEY must be sk_test_...
#   STRIPE_MODE=live             -> STRIPE_SECRET_KEY must be sk_live_...
# A live key without STRIPE_MODE=live is rejected, as is a test key under STRIPE_MODE=live.
# Restricted keys (rk_...) are not supported. See STRIPE-LIVE-MODE.md.
STRIPE_SECRET_KEY=
# The signing secret of the webhook endpoint in the SAME mode as the key above.
STRIPE_WEBHOOK_SECRET=

# Cloudflare Access (Cloudflare secrets)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDIENCE=
ADMIN_EMAIL_ALLOWLIST=

# Worker ordinary variables (set in Cloudflare dashboard Variables section)
SITE_URL=
STRIPE_MODE=test
# Canonical checkout gate. Must be exactly "true" to open checkout; default CLOSED.
# Keep it unset/false until STRIPE_WEBHOOK_SECRET is verified in the target mode.
ENABLE_CHECKOUT=false
# Legacy gate, honoured only when ENABLE_CHECKOUT is NOT set, and only in test mode.
# It can never open live checkout. wrangler.toml still sets it to "false".
ENABLE_STRIPE_TEST_CHECKOUT=false

# Google Analytics 4 (see GA4-INTEGRATION.md). Both are optional; GA is simply off without them.
# Measurement ID: public, G-XXXXXXXXXX. Set it as a RUNTIME Worker variable in the Cloudflare dashboard.
# It is NOT needed at build time: no source file inlines it (NEXT_PUBLIC_* is inlined by `next build`, and
# the build may run where this variable does not exist). The browser reads it per request from
# GET /api/analytics/config, and only after effective analytics consent. GA loads only after a visitor
# accepts analytics (and no Do Not Track / Global Privacy Control).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Measurement Protocol API secret for the server-side purchase (a Cloudflare SECRET, never a plain
# variable, never NEXT_PUBLIC_). Without it no server-side purchase is sent.
GA4_MEASUREMENT_PROTOCOL_SECRET=

# Support inbox (support@kvrn.shop + contact form). Both are Cloudflare SECRETS; see docs/SUPPORT-INBOX-RUNBOOK.md.
# Random string (>= 32 chars). Authenticates the Email Worker's internal POST to the ingest route.
SUPPORT_EMAIL_INGEST_SECRET=
# The owner's private mailbox. Must be a VERIFIED Cloudflare Email Routing destination. Never hardcode it.
SUPPORT_FORWARD_TO=

# ── Admin refresh batch: secrets (Cloudflare SECRETS; never plain variables, never NEXT_PUBLIC_) ──
# Random string (>= 32 chars). Signs the abandoned-checkout recovery link. Without it the recovery link
# fails closed with a 503 and no recovery email is sent.
ABANDONED_LINK_SECRET=
# Random string (>= 32 chars). Peppers the hashes of affiliate portal magic-link tokens and sessions.
AFFILIATE_AUTH_PEPPER=
PUBLIC_API_RATE_PEPPER=
# Random string (>= 32 chars). Salts the affiliate application form token and the IP / user-agent / email hashes.
# If unset the bot check can be forged and those hashes are unsalted: set it before turning applications on.
AFFILIATE_HASH_PEPPER=
# Affiliate payout provider. Leave unset for manual payouts (recommended); no Stripe Connect resources are created by this batch.
AFFILIATE_PAYOUT_PROVIDER=

# ── Admin refresh batch: feature switches (ALL default OFF when unset) ─────────────────────
# Worker variables (Cloudflare dashboard → Variables). Value "on" enables; anything else is OFF.
# Enable ONE at a time, in the order in docs/KVRN-production-setup-migration-rollout-rollback-plan.md.
KVRN_FLAG_CMS_PUBLIC_CONTENT=
KVRN_FLAG_CMS_PRODUCT_ROUTING=
KVRN_FLAG_AFFILIATE_APPLICATIONS=
KVRN_FLAG_AFFILIATE_PORTAL=
KVRN_FLAG_RADAR_FULFILLMENT_HOLDS=
KVRN_FLAG_ABANDONED_CHECKOUT_EMAILS=
KVRN_FLAG_MULTI_CURRENCY_CHECKOUT=
KVRN_FLAG_AFFILIATE_AUTO_PAYOUTS=
# R2 media binding is configured in wrangler.toml as KVRN_MEDIA (no secret/variable needed).

# Local development / integration tests only — never set in Cloudflare
# DEV_ADMIN_EMAIL=
# TEST_DATABASE_URL=

# ── KVRN AI Operating System ──────────────────────────────────────────────────
# Safe rollout: leave AI off and Chief gate off until migration + dashboard + QA are deployed.
AI_ENABLED=false
AI_CHIEF_NOTIFICATION_GATE=false
# Set true ONLY after the external provider/Gateway hard cap has been configured and verified.
AI_EXTERNAL_BUDGET_CAP_CONFIRMED=false
AI_EXTERNAL_BUDGET_CAP_USD=5
AI_GATEWAY_USE_STORED_KEYS=true
AI_BUSINESS_TIMEZONE=America/Los_Angeles
AI_DAILY_BRIEF_HOUR_LOCAL=19
AI_PROVIDER_TIMEOUT_MS=30000
AI_VIDEO_MAX_SECONDS=300

# Provider-native Cloudflare AI Gateway base URLs (ordinary Worker variables; no keys here):
# https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/anthropic
AI_ANTHROPIC_BASE_URL=
# https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/openai
AI_OPENAI_BASE_URL=
# https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/google-ai-studio
AI_GOOGLE_BASE_URL=
AI_GOOGLE_API_VERSION=v1beta

# Model names are variables so KVRN can benchmark/swap without code changes.
AI_ANTHROPIC_CHEAP_MODEL=claude-haiku-5-5
AI_EVAL_HAIKU_MODEL=claude-haiku-5-5
AI_EVAL_LUNA_MODEL=gpt-6-luna
AI_ANTHROPIC_BUSINESS_MODEL=claude-sonnet-5-5
AI_OPENAI_FINANCE_MODEL=gpt-6.1-sol
AI_GOOGLE_VIDEO_MODEL=gemini-3.8-flash
AI_LUNA_INPUT_USD_PER_M=0.10
AI_LUNA_OUTPUT_USD_PER_M=0.50
AI_LUNA_CACHE_INPUT_USD_PER_M=0.01

# Cloudflare secrets — NEVER commit real values. If using AI Gateway Stored Keys/BYOK,
# provider keys can live in Cloudflare's Secrets Store and these provider-key env vars stay empty.
CLOUDFLARE_AI_GATEWAY_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# QA reporting secret used by GitHub Actions -> /api/internal/qa-report.
QA_REPORT_SECRET=

# External evidence sync (deterministic, no model tokens). Keep false until credentials are connected.
AI_EXTERNAL_SYNC_ENABLED=false
AI_WEB_RESEARCH_ENABLED=false

# External-business connectors. Real values are Cloudflare secrets/variables, never committed.
META_GRAPH_API_VERSION=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:kvrn.shop
GOOGLE_MERCHANT_ACCESS_TOKEN=
GOOGLE_MERCHANT_ACCOUNT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Machine-to-machine secrets above should be at least 32 random characters in production.
