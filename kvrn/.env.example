# Neon Postgres — server-only, never expose to browser
DATABASE_URL=postgresql://...

# Cloudflare Access — server-only
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUDIENCE=your-access-application-audience-tag
ADMIN_EMAIL_ALLOWLIST=owner@example.com

# Local dev only — NEVER set in production
# Allows bypassing Cloudflare Access in dev when NODE_ENV !== production
DEV_ADMIN_EMAIL=owner@example.com

# Stripe — test mode only in this phase
# NEVER use sk_live_ keys until inventory reservations + webhooks are complete
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Enable test checkout (set true only in dev/preview)
ENABLE_STRIPE_TEST_CHECKOUT=true

# Your site URL (no trailing slash)
SITE_URL=https://your-domain.com

# Stripe webhook secret — required for NEXT PHASE (webhook fulfillment)
# STRIPE_WEBHOOK_SECRET=whsec_...
